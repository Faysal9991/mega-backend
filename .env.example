# Non-secret development example. Go does not automatically read this file.
# Use an explicit environment supplier; see docs/architecture/RUNTIME_CONFIGURATION.md.
APP_ENV=development
APP_NAME=biho-live-api
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=32768
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_CONCURRENT_REQUESTS=256
# Staging/production require json and an explicit, non-secret replica identifier.
LOG_LEVEL=INFO
LOG_FORMAT=text
INSTANCE_ID=local

# Step 6 runtime: explicit environment supply, no automatic .env loading.
# Set a real secret locally; never use a bootstrap/migration role for the API.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=biho_live_dev
DB_USER=biho_live_dev_app
DB_PASSWORD=
# require is a temporary dev/test exception: encryption, no server identity check.
# Staging/production must use verify-full and trusted CA/DNS/IP identity.
DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/absolute/path/to/trusted-ca.pem
DB_MAX_CONNS=8
DB_CONNECT_TIMEOUT=5s

# Goose always uses explicitly separate DIRECT PostgreSQL settings.
# Never point these at a future PgBouncer transaction-pooling endpoint.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=biho_live_dev
MIGRATION_DB_USER=biho_live_dev_migrator
MIGRATION_DB_PASSWORD=
MIGRATION_DB_SSLMODE=verify-full
MIGRATION_DB_MAX_CONNS=1
MIGRATION_DB_CONNECT_TIMEOUT=5s

# Integration processes need TEST_DB_* and TEST_MIGRATION_DB_* with the
# same suffixes as above, targeting only biho_live_test and its dedicated roles.
# Explicit destructive-test opt-in: BIHO_INTEGRATION_ACK=biho_live_test

# Step 7 optional disposable cache; disabled means no Redis network activity.
REDIS_ENABLED=false
# Replace this placeholder only in ignored local files / secret suppliers.
REDIS_URL=rediss://default:REPLACE_LOCALLY@redis.example.invalid:7200/0
# Default verifies chain and server identity; true is forbidden in staging/prod.
REDIS_TLS_INSECURE_SKIP_VERIFY=false
REDIS_MAX_CONNS=8
REDIS_DIAL_TIMEOUT=2s
REDIS_POOL_TIMEOUT=500ms
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_STARTUP_TIMEOUT=3s
REDIS_OPERATION_TIMEOUT=2s
# Explicit real-test opt-in (not needed for the API):
# BIHO_REDIS_INTEGRATION_ACK=169.58.127.58:7200/0

# Step 8: web/server OAuth audience for Google mobile ID tokens. Empty disables
# only Google verification with SERVICE_UNAVAILABLE; no fake verifier is used.
GOOGLE_CLIENT_ID=
# Optional comma-separated trusted Android/iOS OAuth client IDs for azp.
# The backend audience is always allowed. Configure actual mobile client IDs.
GOOGLE_AUTHORIZED_PARTY_IDS=
