# Non-secret development example. Go does not automatically read this file.
# Use an explicit environment supplier; see docs/architecture/RUNTIME_CONFIGURATION.md.
APP_ENV=development
APP_NAME=biho-live-api
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=32768
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_CONCURRENT_REQUESTS=256
# Staging/production require json and an explicit, non-secret replica identifier.
LOG_LEVEL=INFO
LOG_FORMAT=text
INSTANCE_ID=local
